# Salin menjadi deploy/.env.deploy (diabaikan Git) lalu isi nilainya.
# Autentikasi SSH memakai key dari install-deploy-command.ps1, jangan simpan password di sini.
SSH_HOST=
SSH_PORT=
SSH_USER=
REMOTE_DIR=domains/<domain>/presensi-app
REMOTE_PUBLIC_DIR=domains/<domain>/public_html/presensi
GITHUB_REPO=https://github.com/<owner>/<repo>.git
PUBLIC_URL=https://<domain>/presensi
